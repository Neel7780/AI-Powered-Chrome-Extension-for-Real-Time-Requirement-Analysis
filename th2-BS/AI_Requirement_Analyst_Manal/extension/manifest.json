{
  "manifest_version": 3,
  "name": "Requirement Lens",
  "version": "2.0.0",
  "description": "Live-meeting transcript assistant for requirement clarification.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Requirement Lens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://zoom.us/*", "https://*.zoom.us/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
